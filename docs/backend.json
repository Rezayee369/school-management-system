
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the system.",
          "enum": ["admin", "teacher", "student", "parent", "staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user was created."
        },
        "photoURL": {
            "type": "string",
            "format": "uri",
            "description": "URL of the user's profile picture."
        },
        "studentIds": {
            "type": "array",
            "description": "For parent roles, this contains the UIDs of their linked children.",
            "items": {
                "type": "string"
            }
        },
        "phone": {
            "type": "string",
            "description": "The user's phone number."
        },
        "staffType": {
            "type": "string",
            "description": "The type of staff member.",
            "enum": ["manager", "accountant", "clerk", "supervisor", "guard", "IT"]
        }
      },
      "required": ["fullName", "email", "role", "createdAt"]
    },
    "Class": {
        "title": "Class",
        "description": "Represents a school class.",
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "description": "The name of the class."
            },
            "teacherId": {
              "type": "string",
              "description": "The UID of the assigned teacher."
            },
            "teacherName": {
              "type": "string",
              "description": "The name of the assigned teacher."
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the class was created."
            },
            "studentIds": {
                "type": "array",
                "description": "List of student UIDs enrolled in the class.",
                "items": {
                    "type": "string"
                }
            }
        },
        "required": ["name", "teacherId", "teacherName", "createdAt"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Represents an attendance record for a student in a class on a specific date.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string", "description": "ISO 8601 format date string (YYYY-MM-DD)" },
        "status": {
          "type": "string",
          "enum": ["present", "absent", "leave"]
        },
        "markedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["classId", "studentId", "teacherId", "date", "status", "markedAt"]
    },
    "Grade": {
      "title": "Grade",
      "description": "Represents a grade record for a student in a specific class.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "examScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "assignmentScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["classId", "studentId", "teacherId", "examScore", "assignmentScore", "updatedAt"]
    },
    "Fee": {
      "title": "Fee",
      "description": "Represents a student's fee record for a specific month.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "month": { "type": "string", "description": "The month for the fee in YYYY-MM format." },
        "amount": { "type": "number", "minimum": 0 },
        "discount": { "type": "number", "minimum": 0 },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "month", "amount", "status", "createdAt", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Represents an exam scheduled by a teacher.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "teacherId": { "type": "string" },
        "subject": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["monthly", "midterm", "final"]
        },
        "maxScore": { "type": "number", "minimum": 0 },
        "date": { "type": "string", "description": "ISO 8601 format date string (YYYY-MM-DD)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "teacherId", "subject", "type", "maxScore", "date", "createdAt"]
    },
    "ExamGrade": {
      "title": "Exam Grade",
      "description": "Represents a score a student received for a specific exam.",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "examId",
        "classId",
        "studentId",
        "teacherId",
        "score",
        "maxScore",
        "submittedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Represents a broadcasted message sent by an admin.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "targetRole": {
          "type": "string",
          "enum": ["all", "admin", "teacher", "student", "parent", "staff"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["title", "message", "targetRole", "createdAt"]
    },
    "NotificationReadState": {
      "title": "User Notification Read State",
      "description": "Tracks which notifications a user has read.",
      "type": "object",
      "properties": {
        "readNotificationIds": {
          "type": "array",
          "description": "An array of notification IDs that the user has marked as read.",
          "items": { "type": "string" }
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/classes/{classId}": {
      "schema": {
        "$ref": "#/backend/entities/Class"
      },
      "description": "Stores information about school classes."
    },
    "/attendance/{attendanceId}": {
      "schema": {
        "$ref": "#/backend/entities/Attendance"
      },
      "description": "Stores all attendance records for all classes."
    },
    "/grades/{gradeId}": {
      "schema": {
        "$ref": "#/backend/entities/Grade"
      },
      "description": "Stores grade records for students. The gradeId is a composite of classId_studentId."
    },
    "/fees/{feeId}": {
      "schema": {
        "$ref": "#/backend/entities/Fee"
      },
      "description": "Stores student fee records. The feeId is a composite of studentId_YYYY-MM."
    },
    "/exams/{examId}": {
      "schema": {
        "$ref": "#/backend/entities/Exam"
      },
      "description": "Stores exam details."
    },
    "/examGrades/{examGradeId}": {
      "schema": {
        "$ref": "#/backend/entities/ExamGrade"
      },
      "description": "Stores individual student scores for specific exams. The document ID is a composite of {examId}_{studentId}."
    },
    "/notifications/{notificationId}": {
        "schema": {
            "$ref": "#/backend/entities/Notification"
        },
        "description": "Stores all notifications sent by administrators."
    },
    "/userReadStates/{userId}": {
        "schema": {
            "$ref": "#/backend/entities/NotificationReadState"
        },
        "description": "Stores the read status of notifications for each user."
    }
  }
}
