{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the system.",
          "enum": ["admin", "teacher", "student", "parent"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user was created."
        },
        "photoURL": {
            "type": "string",
            "format": "uri",
            "description": "URL of the user's profile picture."
        }
      },
      "required": ["fullName", "email", "role", "createdAt"]
    },
    "Class": {
        "title": "Class",
        "description": "Represents a school class.",
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "description": "The name of the class."
            },
            "teacherId": {
              "type": "string",
              "description": "The UID of the assigned teacher."
            },
            "teacherName": {
              "type": "string",
              "description": "The name of the assigned teacher."
            },
            "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "The timestamp when the class was created."
            },
            "studentIds": {
                "type": "array",
                "description": "List of student UIDs enrolled in the class.",
                "items": {
                    "type": "string"
                }
            }
        },
        "required": ["name", "teacherId", "teacherName", "createdAt"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Represents an attendance record for a student in a class on a specific date.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "date": { "type": "string", "description": "ISO 8601 format date string (YYYY-MM-DD)" },
        "status": {
          "type": "string",
          "enum": ["present", "absent", "leave"]
        },
        "markedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["classId", "studentId", "teacherId", "date", "status", "markedAt"]
    },
    "Grade": {
      "title": "Grade",
      "description": "Represents a grade record for a student in a specific class.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "teacherId": { "type": "string" },
        "examScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "assignmentScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["classId", "studentId", "teacherId", "examScore", "assignmentScore", "updatedAt"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    },
    "/classes/{classId}": {
      "schema": {
        "$ref": "#/backend/entities/Class"
      },
      "description": "Stores information about school classes."
    },
    "/attendance/{attendanceId}": {
      "schema": {
        "$ref": "#/backend/entities/Attendance"
      },
      "description": "Stores all attendance records for all classes."
    },
    "/grades/{gradeId}": {
      "schema": {
        "$ref": "#/backend/entities/Grade"
      },
      "description": "Stores grade records for students. The gradeId is a composite of classId_studentId."
    }
  }
}
