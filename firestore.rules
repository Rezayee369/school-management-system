
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    function isTeacher() {
      return request.auth != null && getUserRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return request.auth != null && getUserRole(request.auth.uid) == 'parent';
    }

    function isClassTeacher(classId, userId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == userId;
    }

    match /users/{userId} {
      // Admins can read and write any user document.
      allow read, write: if isAdmin();
      
      // Non-admins:
      // Can create their own user document (e.g., on first sign-in).
      allow create: if isOwner(userId);
      // Can read their own user document.
      allow read: if isOwner(userId);
      // Can update their own document, but CANNOT change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }
    
    match /classes/{classId} {
      // Admins can manage classes.
      allow write: if isAdmin();
      // Admins and Teachers can read class information. Parents also need to read this to get teacher names.
      allow read: if isAdmin() || isTeacher() || isParent();
    }
    
    match /attendance/{attendanceId} {
      // Teachers can create attendance records only for their own classes.
      // The incoming data must also correctly state the teacher's UID.
      allow create: if isTeacher() 
                    && isClassTeacher(request.resource.data.classId, request.auth.uid)
                    && request.resource.data.teacherId == request.auth.uid;
                    
      // Admins can read all. Teachers can read records for their classes.
      // Students can read their own records. Parents can read records for their children.
      allow read: if isAdmin() || 
                   (isTeacher() && isClassTeacher(resource.data.classId, request.auth.uid)) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
      
      // Teachers can update records for their classes, but not change key fields. Admins can update any.
      allow update: if isAdmin() || 
                    (isTeacher() && isClassTeacher(resource.data.classId, request.auth.uid) &&
                     request.resource.data.classId == resource.data.classId &&
                     request.resource.data.studentId == resource.data.studentId &&
                     request.resource.data.teacherId == request.auth.uid);
      
      // Only Admins can delete records.
      allow delete: if isAdmin();
    }

    match /grades/{gradeId} {
      // Admins can read/write any grade.
      allow read, write: if isAdmin();
      
      // Teachers can create/update grades for their own classes.
      allow create, update: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      
      // Teachers can read grades for their classes.
      // Students can read their own grades.
      // Parents can read grades for their linked children (assumes `studentIds` field on parent's user doc).
      allow read: if (isTeacher() && resource.data.teacherId == request.auth.uid) || 
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
    }

    match /fees/{feeId} {
      // Admins can read/write any fee record.
      allow read, write: if isAdmin();

      // The feeId is formatted as 'studentId_YYYY-MM'.
      function getStudentIdFromFeeId(feeId) {
        return feeId.split('_')[0];
      }

      // Students can read their own fee records.
      // Parents can read fee records for their linked children.
      allow read: if (request.auth != null && getStudentIdFromFeeId(feeId) == request.auth.uid) ||
                   (isParent() && getStudentIdFromFeeId(feeId) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
    }

    match /exams/{examId} {
      // Admins can manage all exams.
      allow write: if isAdmin();

      // Teachers can create exams for their classes, and must be the owner.
      allow create: if isTeacher() 
                    && request.resource.data.teacherId == request.auth.uid
                    && isClassTeacher(request.resource.data.classId, request.auth.uid);

      // Authenticated users can read exam details. The app is responsible for filtering.
      allow read: if request.auth != null;
      
      // Teachers can update/delete their own exams. Admins can update/delete any.
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /examGrades/{examGradeId} {
      // Admins can manage everything
      allow read, write: if isAdmin();

      // Teacher can create a grade if they are the teacher for the exam's class
      // and they are the owner of the grade record. They cannot update it once created.
      allow create: if isTeacher()
                     && request.resource.data.teacherId == request.auth.uid
                     && isClassTeacher(request.resource.data.classId, request.auth.uid)
                     && request.resource.data.score <= request.resource.data.maxScore
                     && request.resource.data.score >= 0;

      // Students, Parents, and the Teacher who created it can read.
      allow read: if (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
    }
    
    match /announcements/{announcementId} {
      // Admins can create/update/delete.
      allow write: if isAdmin();
      // Admins and Parents can read. Client-side logic filters for relevancy.
      allow read: if isAdmin() || isParent();
    }
  }
}
