rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    function isTeacher() {
      return request.auth != null && getUserRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return request.auth != null && getUserRole(request.auth.uid) == 'parent';
    }

    function isClassTeacher(classId, userId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == userId;
    }

    match /users/{userId} {
      // Admins can read and write any user document.
      allow read, write: if isAdmin();
      
      // Non-admins:
      // Can create their own user document (e.g., on first sign-in).
      allow create: if isOwner(userId);
      // Can read their own user document.
      allow read: if isOwner(userId);
      // Can update their own document, but CANNOT change their role.
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
    }
    
    match /classes/{classId} {
      // Admins can manage classes.
      allow write: if isAdmin();
      // Admins and Teachers can read class information.
      allow read: if isAdmin() || isTeacher();
    }
    
    match /attendance/{attendanceId} {
      // Teachers can create attendance records only for their own classes.
      // The incoming data must also correctly state the teacher's UID.
      allow create: if isTeacher() 
                    && isClassTeacher(request.resource.data.classId, request.auth.uid)
                    && request.resource.data.teacherId == request.auth.uid;
                    
      // Admins can read all. Teachers can read records for their classes.
      // Students can read their own records. Parents can read records for their children.
      allow read: if isAdmin() || 
                   (isTeacher() && isClassTeacher(resource.data.classId, request.auth.uid)) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
      
      // Teachers can update records for their classes, but not change key fields. Admins can update any.
      allow update: if isAdmin() || 
                    (isTeacher() && isClassTeacher(resource.data.classId, request.auth.uid) &&
                     request.resource.data.classId == resource.data.classId &&
                     request.resource.data.studentId == resource.data.studentId &&
                     request.resource.data.teacherId == request.auth.uid);
      
      // Only Admins can delete records.
      allow delete: if isAdmin();
    }

    match /grades/{gradeId} {
      // Admins can read/write any grade.
      allow read, write: if isAdmin();
      
      // Teachers can create/update grades for their own classes.
      allow create, update: if isTeacher() && request.resource.data.teacherId == request.auth.uid;
      
      // Teachers can read grades for their classes.
      // Students can read their own grades.
      // Parents can read grades for their linked children (assumes `studentIds` field on parent's user doc).
      allow read: if (isTeacher() && resource.data.teacherId == request.auth.uid) || 
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
    }
  }
}
