
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      // This get() call requires read access to the users collection.
      // This is granted below. It's safe because only admins can read all profiles,
      // and other users can only read non-staff profiles or their own.
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      // Important: For this to work, the rules for /users/{userId} MUST
      // allow the currently authenticated user to read their own document.
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    function isTeacher() {
      return request.auth != null && getUserRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return request.auth != null && getUserRole(request.auth.uid) == 'parent';
    }
    
    function isStaff() {
      return request.auth != null && getUserRole(request.auth.uid) == 'staff';
    }

    // Check if the user is the teacher assigned to a specific class.
    function isClassTeacher(classId, userId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Admins can read any profile.
      // Users can read their own profile.
      // Staff can only read their own profile.
      // Other authenticated users can read profiles of non-staff members. This protects staff data
      // from being read by other non-admin roles.
      allow read: if request.auth != null && (
                    isAdmin() || 
                    isOwner(userId) ||
                    resource.data.role != 'staff'
                  );
      
      // Admins can perform any write operation.
      // Users can create their own profile (but not as an admin).
      // Users can update their own profile, but cannot change their role.
      allow create: if isAdmin() || (isOwner(userId) && request.resource.data.role != 'admin');
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    
    match /classes/{classId} {
      // Admins can manage classes.
      allow write: if isAdmin();
      // Admins, Teachers, and Parents need to read class information.
      allow read: if request.auth != null && (isAdmin() || isTeacher() || isParent());
    }
    
    match /attendance/{attendanceId} {
      // Read access for relevant roles.
      allow read: if isAdmin() || 
                   (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
      
      // Write access for teachers (create/update) and admins (full access).
      allow write: if isAdmin() ||
                   (isTeacher() && isClassTeacher(request.resource.data.classId, request.auth.uid));
    }

    match /grades/{gradeId} {
      // Read access for relevant roles.
      allow read: if isAdmin() ||
                   (isTeacher() && resource.data.teacherId == request.auth.uid) || 
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
                   
      // Write access for teachers (create/update) and admins (full access).
      allow write: if isAdmin() ||
                   (isTeacher() && request.resource.data.teacherId == request.auth.uid);
    }

    match /fees/{feeId} {
      function getStudentIdFromFeeId(feeId) {
        return feeId.split('_')[0];
      }

      // Read access for relevant roles.
      allow read: if isAdmin() ||
                   (request.auth != null && getStudentIdFromFeeId(feeId) == request.auth.uid) ||
                   (isParent() && getStudentIdFromFeeId(feeId) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);
                   
      // Full write access for admins only.
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      // Any authenticated user can read exam details.
      allow read: if request.auth != null;
      
      // Write access for teachers (create/update/delete their own) and admins (full access).
      allow write: if isAdmin() ||
                   (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /examGrades/{examGradeId} {
      // Read access for relevant roles.
      allow read: if isAdmin() ||
                   (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   (isParent() && resource.data.studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds);

      // Create access for teachers, full write for admins. Grades are immutable for teachers.
      allow create: if isTeacher()
                     && request.resource.data.teacherId == request.auth.uid
                     && isClassTeacher(request.resource.data.classId, request.auth.uid)
                     && request.resource.data.score <= request.resource.data.maxScore
                     && request.resource.data.score >= 0;
      allow update, delete: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      // Admins can write notifications.
      allow write: if isAdmin();
      // Any authenticated user can read a notification if it's for their role or for 'all'.
      allow read: if request.auth != null && 
                   (resource.data.targetRole == 'all' || resource.data.targetRole == getUserRole(request.auth.uid));
    }

    match /userReadStates/{userId} {
      // Users can only read and modify their own read states.
      allow read, write: if isOwner(userId);
    }
  }
}
