
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      // This function relies on the `get` rule for /users/{userId} allowing this read.
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    function isTeacher() {
      return request.auth != null && getUserRole(request.auth.uid) == 'teacher';
    }

    function isParent() {
      return request.auth != null && getUserRole(request.auth.uid) == 'parent';
    }
    
    function isStaff() {
      return request.auth != null && getUserRole(request.auth.uid) == 'staff';
    }

    // Check if the user is the teacher assigned to a specific class.
    function isClassTeacher(classId, userId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == userId;
    }
    
    // Check if a parent is linked to a specific student
    function isParentOf(studentId) {
      return isParent() && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentIds;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // GET: A user can get their own doc (to read their role), OR an admin can get any doc.
      // The isOwner check is vital to break the potential recursion for isAdmin().
      allow get: if isOwner(userId) || isAdmin();
      
      // LIST: Only an admin can perform queries on the users collection.
      allow list: if isAdmin();

      // WRITE Operations:
      allow create: if (isOwner(userId) && request.resource.data.role != 'admin') || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /classes/{classId} {
      // Admins can create, update, or delete any class.
      allow write: if isAdmin();
      
      // Any authenticated user can read class information. This is generally safe.
      allow read: if request.auth != null;
    }
    
    match /attendance/{attendanceId} {
      // GET: Admins, the specific teacher, the specific student, or the student's parent can get a single record.
      allow get: if isAdmin() || 
                   (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   isParentOf(resource.data.studentId);

      // LIST: Only Admins can perform broad queries needed for the dashboard.
      // Other roles would need more specific rules combined with query constraints.
      allow list: if isAdmin();
      
      // WRITE: Admins or the assigned class teacher can write.
      allow write: if isAdmin() ||
                   (isTeacher() && isClassTeacher(request.resource.data.classId, request.auth.uid));
    }

    match /grades/{gradeId} {
      // GET: Admins, the specific teacher, the specific student, or the student's parent can read.
      allow get: if isAdmin() ||
                   (isTeacher() && resource.data.teacherId == request.auth.uid) || 
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   isParentOf(resource.data.studentId);
        
      // LIST: Only Admins and Teachers can perform queries.
      // Student/Parent queries must be more constrained.
      allow list: if isAdmin() || isTeacher();
                   
      // WRITE: Admins or the assigned teacher can write grades.
      allow write: if isAdmin() ||
                   (isTeacher() && request.resource.data.teacherId == request.auth.uid);
    }

    match /fees/{feeId} {
      function getStudentIdFromFeeId(feeId) {
        return feeId.split('_')[0];
      }

      // GET: Admins, the student, or the student's parent can read.
      allow get: if isAdmin() ||
                   (request.auth != null && getStudentIdFromFeeId(feeId) == request.auth.uid) ||
                   isParentOf(getStudentIdFromFeeId(feeId));

      // LIST: Only Admins can query the fees collection for reports.
      allow list: if isAdmin();
                   
      // WRITE: Only Admins can create, update, or delete fee records.
      allow write: if isAdmin();
    }

    match /exams/{examId} {
      // Any authenticated user can read exam details.
      allow read: if request.auth != null;
      
      // Admins can write any exam.
      // A teacher can write an exam only if they are the specified teacher for that exam.
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /examGrades/{examGradeId} {
      // GET: Admins, the specific teacher, the specific student, or the student's parent can read.
      allow get: if isAdmin() ||
                   (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                   (request.auth != null && resource.data.studentId == request.auth.uid) ||
                   isParentOf(resource.data.studentId);

      // LIST: Admins and Teachers can query.
      allow list: if isAdmin() || isTeacher();

      // A teacher can create a grade for a student if they teach that class.
      // The score must be valid. Once created, teachers cannot update/delete (admins can).
      allow create: if isTeacher()
                     && request.resource.data.teacherId == request.auth.uid
                     && isClassTeacher(request.resource.data.classId, request.auth.uid)
                     && request.resource.data.score <= request.resource.data.maxScore
                     && request.resource.data.score >= 0;
      // Only admins can update or delete submitted grades.
      allow update, delete: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      // Only admins can write notifications.
      allow write: if isAdmin();
      // Any authenticated user can read a notification if it's for 'all' or their specific role.
      allow read: if request.auth != null && 
                   (resource.data.targetRole == 'all' || resource.data.targetRole == getUserRole(request.auth.uid));
    }

    match /userReadStates/{userId} {
      // Users can only read and write their own read-state documents.
      allow read, write: if isOwner(userId);
    }
  }
}
